# MySQL：Compose 首次创建数据库和应用账号时使用。请将两个密码都换成强密码。
MYSQL_DATABASE=knowledge
MYSQL_USER=kb
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me
# 可选：完整 SQLAlchemy 数据库连接串。留空时应用根据 MYSQL_* 配置安全构造连接串。
# DATABASE_URL=mysql+pymysql://kb:replace-me@mysql:3306/knowledge

# JWT：登录令牌签名密钥。必须替换为至少 32 字节的随机值；不要提交真实密钥。
JWT_SECRET=replace-with-a-long-random-secret
# JWT 有效期，单位分钟；1440 分钟 = 24 小时。
JWT_MINUTES=1440

# 浏览器与 API：CORS_ORIGINS 填允许访问 API 的 Web 来源，可用逗号分隔多个来源。
# VITE_API_URL 会在 Web 镜像构建时写入前端；远程部署时填写浏览器可访问的 API 地址并重建镜像。
CORS_ORIGINS=http://localhost:8020
VITE_API_URL=http://localhost:8022

# 服务间连接：以下主机名适用于 Docker Compose 网络；Compose 会向 API/Worker 注入对应配置。
REDIS_URL=redis://redis:6379/0
CHROMA_HOST=chroma
CHROMA_PORT=8000

# 向量模型只通过第三方 API 调用；base URL 填 API 根地址，程序会追加 /embeddings。
# 文档片段和查询文本会发送到该服务商；模型名须是服务商支持的 embedding 模型。
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-your-embedding-key

# 重排模型只通过第三方 API 调用；base URL 填 API 根地址，程序会追加 /rerank。
# API 需返回 results 中的 index 和 relevance_score 字段；可按服务商策略复用同一个 Key。
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_KEY=replace-with-your-reranker-key

# 上传文档在容器内的持久化目录；Compose 将其挂载到 uploads 卷。
UPLOAD_DIR=/data/uploads

# LLM：布尔开关，只能填写 true 或 false。false 关闭聊天模型调用，true 启用。
# 本地或云端地址由 LLM_BASE_URL 决定。云端地址必须使用 HTTPS。
LLM_MODE=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional. Enable only when the configured OpenAI-compatible provider supports streaming usage metadata.
LLM_STREAM_USAGE=false
# USD per 1,000,000 input/output tokens; leave blank to show usage without a cost estimate.
LLM_INPUT_PRICE_PER_1M=
LLM_OUTPUT_PRICE_PER_1M=

# 单会话短期记忆预算；旧轮次超过窗口后压缩到滚动摘要。
MEMORY_HISTORY_TOKEN_BUDGET=6000
MEMORY_SUMMARY_TOKEN_BUDGET=1200
MEMORY_SUMMARY_OUTPUT_TOKENS=1500
MEMORY_WORKSPACE_TOKEN_BUDGET=1200

# 可选的云端请求脱敏规则；未配置时原文会发送给配置的云端提供方。
# 配置后使用 JSON 数组，例如 [{"pattern":"敏感信息正则","replacement":"[REDACTED]"}]；规则解析/执行失败时请求会被拒绝。
REDACTION_RULES=
