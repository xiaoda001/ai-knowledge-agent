# Use the exact URL through which users will open the local Langfuse UI.
NEXTAUTH_URL=http://SERVER_LAN_IP:3001
LANGFUSE_PORT=3001
MINIO_PORT=9092
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=http://SERVER_LAN_IP:9092

# Generate distinct random values for every secret. Hex values avoid URL/Compose escaping issues.
POSTGRES_PASSWORD=replace-with-random-hex
CLICKHOUSE_PASSWORD=replace-with-random-hex
REDIS_AUTH=replace-with-random-hex
MINIO_ROOT_PASSWORD=replace-with-random-hex
SALT=replace-with-random-hex
NEXTAUTH_SECRET=replace-with-random-hex
# Exactly 64 hexadecimal characters (256 bits).
ENCRYPTION_KEY=replace-with-64-hex-characters

# Langfuse's product telemetry is disabled by default for local-only operation.
TELEMETRY_ENABLED=false
